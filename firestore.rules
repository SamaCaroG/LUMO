rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-z0-9]+@artesplasticasdocente\\.lumo\\.invalid$');
    }

    function canSubmitForGrade(grade) {
      return request.auth != null
        && request.auth.token.email is string
        && (
          (grade == 1 && request.auth.token.email.matches('^[a-z0-9]+@artesestudiante1\\.lumo\\.invalid$'))
          || (grade == 2 && request.auth.token.email.matches('^[a-z0-9]+@artesestudiante2\\.lumo\\.invalid$'))
          || (grade == 3 && request.auth.token.email.matches('^[a-z0-9]+@artesestudiante3\\.lumo\\.invalid$'))
        );
    }

    match /diagnosticos/{diagnosticId} {
      allow read: if isTeacher();
      allow create: if canSubmitForGrade(request.resource.data.grade)
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.keys().hasAll([
          'studentName', 'grade', 'gradeLabel', 'areas', 'answers', 'failedAreas',
          'totalCorrect', 'totalQuestions', 'scorePercentage', 'submittedBy', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentName', 'grade', 'gradeLabel', 'areas', 'answers', 'failedAreas',
          'totalCorrect', 'totalQuestions', 'scorePercentage', 'submittedBy', 'createdAt'
        ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 80
        && (
          (request.resource.data.grade == 1 && request.resource.data.gradeLabel == '1°')
          || (request.resource.data.grade == 2 && request.resource.data.gradeLabel == '2°')
          || (request.resource.data.grade == 3 && request.resource.data.gradeLabel == '3°')
        )
        && request.resource.data.areas is map
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 8
        && request.resource.data.failedAreas is list
        && request.resource.data.failedAreas.size() <= 8
        && request.resource.data.totalCorrect is int
        && request.resource.data.totalCorrect >= 0
        && request.resource.data.totalCorrect <= 8
        && request.resource.data.totalQuestions == 8
        && request.resource.data.scorePercentage is int
        && request.resource.data.scorePercentage >= 0
        && request.resource.data.scorePercentage <= 100
        && request.resource.data.submittedBy is string
        && request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }
  }
}
